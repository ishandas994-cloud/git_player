{
  "buildCommand": "cd api && npm install && npm run build && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo skip-root-install",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 15
    }
  },
  "excludes": [
    "api/src/**",
    "api/dist/**",
    "api/test-*.ts",
    "api/test-*.mjs",
    "api/*.ts",
    "api/cmd/**"
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}